#!/bin/bash
# clinic-curl-verdict <curl arguments...>
# Runs curl and turns its exit code into clinic-probe's three answers:
#   0 reached, 1 blocked (could not connect, or timed out), 2 error.
# Everything else curl can say is an error, not "blocked": a name that does
# not resolve (6), a bad URL (3), a TLS failure (35), an HTTP error status
# (22, with -f), a dropped reply (52, 56). Those mean the network question
# was not answered, or something unexpected answered, and a human should look.
curl "$@"
rc=$?
case $rc in
    0)     exit 0 ;;
    7|28)  exit 1 ;;   # 7: connection refused or no route, 28: timed out
    *)     echo "curl failed with exit code $rc (see 'man curl', EXIT CODES)" >&2; exit 2 ;;
esac
