#!/usr/bin/env python3
"""A public website on the simulated internet (HTTP 80 and HTTPS 443).

/whoami answers with the address the request came from, as this website
sees it: from a clinic machine that must be the clinic's public address
(the router translates every outgoing connection to it).
"""
import http.server
import ssl
import subprocess
import threading

PAGE = b"<!doctype html><title>example.org</title><h1>A public website</h1>\n"


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/whoami":
            body, kind = (self.client_address[0] + "\n").encode(), "text/plain"
        else:
            body, kind = PAGE, "text/html"
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        print(f"web: {self.client_address[0]} {fmt % args}", flush=True)


def serve(port, tls):
    srv = http.server.ThreadingHTTPServer(("0.0.0.0", port), Handler)
    if tls:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain("/run/clinic/web.crt", "/run/clinic/web.key")
        srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
    srv.serve_forever()


subprocess.run(["clinic-selfsigned", "/run/clinic/web", "example.org"], check=True)
threading.Thread(target=serve, args=(80, False), daemon=True).start()
serve(443, True)
