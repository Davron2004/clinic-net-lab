#!/bin/bash
# clinic-probe-https-direct <host> [port] [timeout]: HTTPS sent out of the
# machine's own network cable (eth1), never through a VPN tunnel. On the
# remote doctor's laptop this asks: "with the VPN off, can I still get in?"
# Exit status as clinic-probe: 0 reached, 1 blocked, 2 error.
exec clinic-curl-verdict -skf -o /dev/null --interface eth1 --connect-timeout "${3:-3}" --max-time $((${3:-3} + 2)) \
    "https://$1:${2:-443}/"
