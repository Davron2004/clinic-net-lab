#!/usr/bin/env python3
"""Writes a dozen synthetic patient charts. Names are invented; IDs are fake.

The patient list lives in /usr/local/share/clinic/patients.json so the imaging
workstation and the lab analyzer produce studies and results for the same
(synthetic) people the EMR knows.
"""
import json
import os
import sys

with open("/usr/local/share/clinic/patients.json") as f:
    PATIENTS = json.load(f)

out = sys.argv[1]
for i, p in enumerate(PATIENTS, start=1):
    path = os.path.join(out, f"patient-{i:04d}.json")
    if os.path.exists(path):
        continue
    with open(path, "w") as f:
        json.dump({"mrn": p["mrn"], "name": p["name"], "dob": p["dob"],
                   "last_visit_note": p["note"], "synthetic": True}, f, indent=2)
