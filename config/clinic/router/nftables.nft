#!/usr/sbin/nft -f
# Clinic firewall policy.
#
# Default deny: a packet crossing from one zone to another is dropped unless
# a rule below allows it. Each allow rule names one source, one destination
# and one service. Every new connection allowed between zones and every drop
# is logged (NFLOG group 0 -> ulogd -> firewall.jsonl); the prefix is the
# rule's name. Not logged: DNS, DHCP and ping to the router itself (accepted
# below without a log rule), and traffic inside a zone, which never reaches
# the router (the switch stops it instead; see switch/ports.conf).
#
# The isolation tests in policy/clinic.yml check this file from the outside.
# They are written separately on purpose: if a rule here is wrong, the
# tests catch it instead of inheriting the same mistake.

flush ruleset

define WAN      = "eth1"
define STAFF    = "eth2.10"
define SERVERS  = "eth2.20"
define DEVICES  = "eth2.30"
define PRINTERS = "eth2.40"
define GUEST    = "eth2.50"
define VPN      = "wg0"       # remote access tunnel (WireGuard, 10.10.60.0/24)
define SECURITY = "eth2.90"

define EMR           = 10.10.20.10
define PACS          = 10.10.20.20
define IMAGING       = 10.10.30.10
define LAB_ANALYZER  = 10.10.30.11
define PRINTER       = 10.10.40.10
define SIEM          = 10.10.90.10

table inet clinic {

    # Anti-spoofing, before anything else looks at a packet. Every rule below
    # trusts the source address, so check it is plausible: a packet must
    # arrive on the interface the router would use to reach its source
    # ("reverse path"). A guest claiming the EMR server's address arrives on
    # the guest VLAN, but the EMR lives on the servers VLAN: dropped. This
    # covers every zone, the VPN and the internet side. It cannot catch a
    # machine borrowing a neighbour's address in its own subnet; see the
    # README's limits.
    chain prerouting {
        type filter hook prerouting priority filter; policy accept;
        iif "lo" accept
        # A guest asking for an address has none yet: DHCP comes from 0.0.0.0.
        iifname $GUEST ip saddr 0.0.0.0 udp sport 68 udp dport 67 accept
        meta nfproto ipv4 fib saddr . iif oif missing log group 0 prefix "deny:spoofed" drop
    }

    # Traffic addressed to the router itself.
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # Ping the gateway from inside: basic troubleshooting.
        iifname { $STAFF, $SERVERS, $DEVICES, $PRINTERS, $GUEST, $SECURITY } icmp type echo-request accept
        # DNS for zones that browse by name. Servers, devices and printers get
        # none: DNS queries can smuggle data out, and they only need fixed IPs.
        iifname { $STAFF, $GUEST } meta l4proto { tcp, udp } th dport 53 accept
        # DHCP leases for guest Wi-Fi.
        iifname $GUEST udp dport 67 accept
        # The VPN's front door: the only thing the internet may send the
        # router. WireGuard answers nothing but a valid handshake from an
        # enrolled key, so a scanner gets the same silence here as from every
        # dropped port ("open|filtered"): it cannot tell a VPN is listening.
        iifname $WAN udp dport 51820 log group 0 prefix "allow:vpn-handshake" accept

        log group 0 prefix "deny:to-router" drop
    }

    # Traffic passing through the router from one zone to another.
    chain forward {
        type filter hook forward priority filter; policy drop;
        # Replies to connections we already allowed.
        ct state established,related accept
        ct state invalid drop

        iifname vmap {
            $STAFF    : jump from_staff,
            $SERVERS  : jump from_servers,
            $DEVICES  : jump from_devices,
            $PRINTERS : jump from_printers,
            $GUEST    : jump from_guest,
            $SECURITY : jump from_security,
            $WAN      : jump from_internet,
            $VPN      : jump from_remote,
        }
        log group 0 prefix "deny:default" drop
    }

    chain from_staff {
        ip daddr $EMR tcp dport 443 log group 0 prefix "allow:staff-emr-https" accept
        ip daddr $PACS tcp dport 8042 log group 0 prefix "allow:staff-pacs-viewer" accept
        ip daddr $PRINTER tcp dport { 631, 9100 } log group 0 prefix "allow:staff-print" accept
        oifname $WAN tcp dport { 80, 443 } log group 0 prefix "allow:staff-web" accept
        log group 0 prefix "deny:staff" drop
    }

    chain from_servers {
        # Servers start no connections of their own, with one exception: the
        # EMR server's security agent reports to the SIEM (1514 events,
        # 1515 enrollment). Replies are handled above.
        ip saddr $EMR ip daddr $SIEM tcp dport { 1514, 1515 } log group 0 prefix "allow:emr-siem" accept
        oifname $WAN log group 0 prefix "deny:server-internet" drop
        log group 0 prefix "deny:servers" drop
    }

    chain from_devices {
        # Each device may do its one job and nothing else.
        ip saddr $IMAGING ip daddr $PACS tcp dport 4242 log group 0 prefix "allow:imaging-pacs-dicom" accept
        ip saddr $LAB_ANALYZER ip daddr $EMR tcp dport 2575 log group 0 prefix "allow:lab-emr-hl7" accept
        # No internet for medical devices. Logged separately: it is the alert that matters.
        oifname $WAN log group 0 prefix "deny:device-internet" drop
        log group 0 prefix "deny:devices" drop
    }

    chain from_printers {
        oifname $WAN log group 0 prefix "deny:printer-internet" drop
        log group 0 prefix "deny:printers" drop
    }

    chain from_guest {
        # Guests get the web and nothing inside the clinic.
        oifname $WAN tcp dport { 80, 443 } log group 0 prefix "allow:guest-web" accept
        log group 0 prefix "deny:guest" drop
    }

    chain from_remote {
        # A doctor working from home, through the VPN. The tunnel proves who
        # they are; this chain decides what that buys them: the EMR web app
        # and nothing else. No file shares, no admin shells, no staff PCs, no
        # image archive, and no using the clinic as a route to the internet.
        ip daddr $EMR tcp dport 443 log group 0 prefix "allow:remote-emr-https" accept
        oifname $WAN log group 0 prefix "deny:remote-internet" drop
        log group 0 prefix "deny:remote" drop
    }

    chain from_security {
        # The SIEM only listens: agents connect to it, it connects to nothing.
        # (The router's own agent talks to it directly from 10.10.90.1; the
        # router's own traffic does not pass through this forward chain.)
        oifname $WAN log group 0 prefix "deny:siem-internet" drop
        log group 0 prefix "deny:security" drop
    }

    chain from_internet {
        # Nothing on the internet may open a connection into the clinic.
        log group 0 prefix "deny:inbound" drop
    }
}

# Outbound address translation: the clinic has one public address.
# Only zones that are allowed out need it.
table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat;
        oifname "eth1" ip saddr { 10.10.10.0/24, 10.10.50.0/24 } masquerade
    }
}
